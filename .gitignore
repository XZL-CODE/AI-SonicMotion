# 数据科学和机器学习
## 保留文件夹结构但忽略内容
model/*
!model/.gitkeep
# data/*
# !data/.gitkeep
**/model/*
!**/model/.gitkeep
# **/data/*
# !**/data/.gitkeep
models/*
!models/.gitkeep
datasets/*
!datasets/.gitkeep
checkpoints/*
!checkpoints/.gitkeep
runs/*
!runs/.gitkeep

# 运行产物：一键启动脚本写的日志、pid 与 Vite 缓存
logs/
.run/
*.pid
.vite/

# 测试文件夹的特定忽略规则
test/**/node_modules/
test/**/.idea/
test/**/.vscode/
test/**/dist/
test/**/build/
test/**/.cache/
test/**/.vite/


